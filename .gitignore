# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# Any virtualenv, wherever it is put. `backend/.venv/` alone missed the
# `venv6/` someone actually built, leaving a few hundred MB of site-packages
# one `git add -A` away from the history.
.venv/
venv*/

# App data (sqlite db + uploaded audio).
#
# LEADING SLASH IS LOAD-BEARING: an unanchored `data/` matches a directory
# named `data` at ANY depth, which silently excluded two files the app cannot
# run without — frontend/src/data/voices.ts (the sign-in reel roster, imported
# by three modules) and backend/coach/data/topics.json (the 40-prompt seed
# bank). Neither had ever been committed, so a fresh clone did not build and
# could not be seeded. Only the repo-root data/ is runtime state.
/data/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/tools/fake_audio.wav   # generated by tools/make-fake-audio.mjs

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scraped YouTube pages saved by the voice-reel research pass (frontend/page_<videoId>.html).
# ~7MB of vendor markup, referenced by nothing in the app.
frontend/page_*.html

# Screenshots dropped at the repo root by the Playwright UI-audit run.
/*.png

# Playwright MCP session output (audit screenshots, console logs, page snapshots).
.playwright-mcp/
